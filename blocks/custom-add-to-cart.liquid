{%- doc -%}
  Custom, standalone "Add to cart" button block.

  Self-contained: it renders its own product form + add-to-cart component, so it
  works anywhere a product is in context (product pages, product cards, etc.)
  WITHOUT touching the theme's original add-to-cart block/snippet.

  Lets the merchant customise the button text and icon (like the button block).
{%- enddoc -%}

{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign variant = product.selected_or_first_available_variant

  assign can_add_to_cart = false
  assign state_text = 'products.product.unavailable' | t
  if variant
    if variant.available
      assign can_add_to_cart = true
      assign state_text = 'products.product.add_to_cart' | t
    else
      assign state_text = 'products.product.sold_out' | t
    endif
  endif

  # Custom label: used when set and the product can be added.
  # Sold out / unavailable keep their dynamic localized text.
  assign button_text = state_text
  if can_add_to_cart and block.settings.label != blank
    assign button_text = block.settings.label
  endif

  # Custom icon (mirrors the button block)
  assign has_custom_icon = false
  if block.settings.icon != blank and block.settings.icon != 'none'
    assign has_custom_icon = true
  endif
  if block.settings.icon_image != blank
    assign has_custom_icon = true
  endif
  assign icon_position = block.settings.icon_position | default: 'before'
  assign icon_size = block.settings.icon_size | default: 18
  assign icon_gap = block.settings.icon_gap | default: 8

  # Include product.id so IDs stay unique when the same static block repeats per card in a grid
  assign product_form_id = 'CustomAddToCart-Form-' | append: section.id | append: '-' | append: block.id | append: '-' | append: product.id
  assign button_id = 'CustomAddToCart-Submit-' | append: block.id | append: '-' | append: product.id
%}

{%- capture custom_icon_markup -%}
  {%- if has_custom_icon -%}
    {%- render 'icon-or-image',
      icon: block.settings.icon,
      image_upload: block.settings.icon_image,
      width: icon_size,
      class_name: 'custom-atc__icon'
    -%}
  {%- endif -%}
{%- endcapture -%}

<div
  class="custom-add-to-cart size-style spacing-style {{ block.settings.custom_class }}"
  style="
    {% render 'size-style', settings: block.settings %}
    {% render 'spacing-style', settings: block.settings %}
    --add-to-cart-font-case: {{ settings.button_text_case }};
  "
  {{ block.shopify_attributes }}
>
  {%- if product != blank -%}
    <product-form-component
      data-section-id="{{ section.id }}"
      data-product-id="{{ product.id }}"
      data-product-url="{{ product.url }}"
      on:submit="/handleSubmit"
    >
      <div
        class="visually-hidden"
        aria-live="assertive"
        role="status"
        aria-atomic="true"
        ref="liveRegion"
      ></div>

      {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
        <input
          type="hidden"
          name="id"
          ref="variantId"
          value="{{ variant.id }}"
          {% if variant.available == false %}disabled{% endif %}
        >
        <input
          type="hidden"
          name="quantity"
          value="{% if variant.quantity_rule.min %}{{ variant.quantity_rule.min }}{% else %}1{% endif %}"
        >

        <add-to-cart-component
          ref="addToCartButtonContainer"
          data-add-to-cart-animation="{{ settings.add_to_cart_animation }}"
        >
          <button
            id="{{ button_id }}"
            type="submit"
            name="add"
            ref="addToCartButton"
            on:click="/handleClick"
            class="button add-to-cart-button custom-add-to-cart__button {{ block.settings.style_class }}{% if has_custom_icon %} custom-add-to-cart__button--with-icon{% endif %}"
            data-testid="custom-add-to-cart"
            {% unless can_add_to_cart %}disabled{% endunless %}
          >
            <span
              class="add-to-cart-text"
              {% if has_custom_icon %}style="gap: {{ icon_gap }}px;"{% endif %}
            >
              {%- if has_custom_icon and icon_position == 'before' -%}{{ custom_icon_markup }}{%- endif -%}
              <span class="add-to-cart-text__content">
                <span>
                  <span>{{ button_text }}</span>
                </span>
              </span>
              {%- if has_custom_icon and icon_position == 'after' -%}{{ custom_icon_markup }}{%- endif -%}
            </span>
            {% comment %} checkmark burst shown after a successful add {% endcomment %}
            <span class="add-to-cart__added">
              <span class="svg-wrapper add-to-cart__added-icon">
                {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
              </span>
            </span>
          </button>
        </add-to-cart-component>
      {%- endform -%}
    </product-form-component>
  {%- else -%}
    <button type="button" class="button custom-add-to-cart__button {{ block.settings.style_class }}" disabled>
      {{ button_text }}
    </button>
  {%- endif -%}
</div>

{% stylesheet %}
  /* Let the width setting (fit-content / fill / custom) flow down to the button */
  .custom-add-to-cart product-form-component,
  .custom-add-to-cart .shopify-product-form,
  .custom-add-to-cart add-to-cart-component {
    display: block;
    width: 100%;
  }

  .custom-add-to-cart__button {
    width: 100%;
    /* Positioning context so the success checkmark (.add-to-cart__added, which is
       position:absolute) centers INSIDE the button. The native button gets this
       from an id-prefixed rule in base.css that our custom id doesn't match. */
    position: relative;
  }

  .custom-add-to-cart__button--with-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .custom-atc__icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
  }
{% endstylesheet %}

